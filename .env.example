# ─── پایگاه داده ─────────────────────────────────────────────────────────────
DATABASE_URL=file:/home/z/my-project/db/custom.db?connection_limit=2

# ─── احراز سرویس داخلی (Next API ⇄ سرویس ربات) ───────────────────────────────
# با دستور openssl rand -hex 24 بسازید
INTERNAL_API_KEY=change-me

# ─── تلگرام (هرگز مقادیر واقعی را کامیت نکنید) ───────────────────────────────
# توکن از @BotFather — خالی بگذارید ⇒ حالت شبیه‌سازی
TELEGRAM_BOT_TOKEN=
# شناسه کانال (مثل -1001234567890) یا @channelusername — ربات باید مدیر کانال باشد
TELEGRAM_CHANNEL_ID=
# شناسه چت فروشنده که اعلان‌های سفارش را دریافت می‌کند
TELEGRAM_ADMIN_CHAT_ID=
# یوزرنیم ربات (بدون @) برای ساخت لینک مستقیم: t.me/<bot>?start=product_<id>
TELEGRAM_BOT_USERNAME=my_store_bot
# true = شبیه‌سازی محلی API تلگرام (توسعه، بدون تماس بیرونی). پیام‌ها در ActivityLog ثبت می‌شوند.
TELEGRAM_MOCK=true
