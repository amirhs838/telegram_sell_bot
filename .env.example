# ─── پایگاه داده ─────────────────────────────────────────────────────────────
DATABASE_URL=file:/home/z/my-project/db/custom.db?connection_limit=2

# ─── احراز سرویس داخلی (Next API ⇄ سرویس ربات) ───────────────────────────────
# با دستور openssl rand -hex 24 بسازید
INTERNAL_API_KEY=change-me

# ─── تلگرام (هرگز مقادیر واقعی را کامیت نکنید) ───────────────────────────────
# توکن از @BotFather — خالی بگذارید ⇒ حالت شبیه‌سازی
TELEGRAM_BOT_TOKEN=
# شناسه کانال (مثل -1001234567890) یا @channelusername — ربات باید مدیر کانال باشد
TELEGRAM_CHANNEL_ID=
# شناسه چت فروشنده که اعلان‌های سفارش را دریافت می‌کند
TELEGRAM_ADMIN_CHAT_ID=
# یوزرنیم ربات (بدون @) برای ساخت لینک مستقیم: t.me/<bot>?start=product_<id>
TELEGRAM_BOT_USERNAME=my_store_bot
# true = شبیه‌سازی محلی API تلگرام (توسعه، بدون تماس بیرونی). پیام‌ها در ActivityLog ثبت می‌شوند.
TELEGRAM_MOCK=true

# ─── AI (backend only — never commit the real key) ──────────────────────────
# کلید OpenRouter (openrouter.ai) — سرویس اصلی دستیار فروش + استودیوی تصویر.
# یک کلید، صدها مدل؛ هزینه بر اساس مصرف از اعتبار حساب کم می‌شود.
# خالی بگذارید ⇒ کلید را می‌توان از پنل مدیریت وارد کرد (Setting «openRouterApiKey»).
OPENROUTER_API_KEY=
# مدل متن (پیش‌فرض: openai/gpt-4o-mini) — می‌توان از پنل تغییر داد (Setting «aiTextModel»)
OPENROUTER_TEXT_MODEL=
# مدل تصویر (پیش‌فرض: google/gemini-nano-banana-2.1) — می‌توان از پنل تغییر داد (Setting «aiImageModel»)
OPENROUTER_IMAGE_MODEL=
# کلید جایگزین اختصاصی فروشنده روی پلتفرم Z.ai (فقط وقتی OpenRouter در دسترس نیست)
ZAI_API_KEY=
# مدل چت روی API عمومی Z.ai (پیش‌فرض: glm-4.5-flash)
AI_CHAT_MODEL=
# مسیر اختیاری ویرایش تصویر روی API عمومی Z.ai —
# فقط وقتی فعال شود که سرویس عمومی این مسیر را پشتیبانی کند؛ در غیر این صورت
# ویرایش تصویر از دروازه پلتفرم اجرا می‌شود.
AI_USER_EDIT_PATH=
# Timezone used when rendering the daily silver-rate post date/time
STORE_TIMEZONE=Asia/Tehran
