# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database (user data, password hashes, logs)
db/custom.db
db/custom.db-shm
db/custom.db-wal

# internal agent notes
worklog.md
agent-ctx/
tool-results/

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# customer payment receipts are PRIVATE — never commit real ones
upload/receipts/*
!upload/receipts/receipt-demo-1005.png

# bot-service runtime lock (single-instance guard)
mini-services/bot-service/.bot-lock

# bot-service runtime files (polling lock + persisted offset)
.bot-lock
.bot-offset.json

# sandbox runtime scripts & artifacts (stay local-only)
.zscripts/

# runtime studio outputs & fresh uploads — stay local
upload/studio-*
upload/[0-9]*-[0-9a-f]*.png
upload/[0-9]*-[0-9a-f]*.jpg
