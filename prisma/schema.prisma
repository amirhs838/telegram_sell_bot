// Silver Love — Telegram Commerce Platform — Prisma schema (SQLite)
// Database is the single source of truth for products, inventory, customers, orders.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("seller") // admin | seller
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  description       String?
  shortDescription  String?
  price             Float             @default(0)
  compareAtPrice    Float?
  stock             Int               @default(0)
  lowStockThreshold Int               @default(5)
  categoryId        String?
  category          Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  imageUrl          String?
  status            String            @default("draft") // draft | active | inactive | out_of_stock
  aiGenerated       Boolean           @default(false)
  tags              String? // JSON array string
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Silver Love — optional product-specific specs (never required, never used for pricing)
  sku               String? // کد محصول (وارد‌شده توسط فروشنده)
  silverType        String? // نوع نقره (دست‌ساز، صنعتی، شمش…)
  purity            String? // عیار (مثل 925)
  weightGrams       Float? // وزن (گرم)
  size              String? // سایز (حلقه/زنجیر/…)
  dimensions        String? // ابعاد
  brand             String? // برند یا سازنده
  appearance        String? // مشخصات ظاهری
  careInstructions  String? // شرایط نگهداری
  authenticity      String? // اصالت و ضمانت

  telegramProducts TelegramProduct[]
  orderItems       OrderItem[]
  embedding        ProductEmbedding?
  images           ProductImage[]
}

// ─── Customers & Orders ──────────────────────────────────────────────────────

model Customer {
  id              String    @id @default(cuid())
  telegramUserId  String    @unique
  telegramUsername String?
  firstName       String
  lastName        String?
  phone           String?
  address         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  orders          Order[]
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  Int         @unique // allocated via Counter inside the order transaction
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status       String      @default("pending") // pending|confirmed|processing|shipped|completed|cancelled
  subtotal     Float
  discount     Float       @default(0)
  total        Float
  customerName String // snapshot
  address      String
  phone        String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
  payment      Payment?

  @@index([status])
  @@index([customerId])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot String // historical orders never change
  unitPriceSnapshot   Float
  quantity            Int
  total               Float

  @@index([orderId])
}

// ─── Telegram integration ────────────────────────────────────────────────────

// Mapping product → channel post, enables editing existing posts (no duplicates)
model TelegramProduct {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  channelId       String
  messageId       Int
  lastContentHash String?
  hasPhoto        Boolean  @default(false)
  publishedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, channelId])
}

// ─── RAG-ready knowledge base ────────────────────────────────────────────────

model ProductEmbedding {
  id         String   @id @default(cuid())
  productId  String   @unique
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  content    String // embedded text
  embedding  String // JSON float[] (vector storage; swap for pgvector/pgvector later)
  metadata   String? // JSON {name, category, price, status}
  model      String   @default("local-hash-v1")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Bot conversation state (survives restarts) ─────────────────────────────

model BotSession {
  telegramUserId String   @id
  state          String   @default("{}") // JSON state machine
  updatedAt      DateTime @updatedAt
}

// Atomic named counters (e.g. orderNumber sequence)
model Counter {
  name  String @id
  value Int    @default(0)
}

// ─── Settings & structured logs ──────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  level     String   @default("info") // info | warn | error
  type      String // order.created, telegram.publish, ai.generate, auth.failed, …
  message   String
  data      String? // JSON payload (never secrets)
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

// ─── Silver Love additions ───────────────────────────────────────────────────

// Product gallery — the primary image is also mirrored into Product.imageUrl
// for backward compatibility with channel publishing and the bot.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String // relative API URL (/api/uploads/<name>)
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

// Manually-entered silver market rate (reference info only — NEVER used to
// compute product prices). History is preserved; the latest active row wins.
model SilverRate {
  id             String   @id @default(cuid())
  pricePerGram   Float // تومان به‌ازای هر گرم نقره
  unit           String   @default("تومان/گرم")
  note           String?
  active         Boolean  @default(true)
  createdByEmail String?
  createdAt      DateTime @default(now())
}

// Store bank destinations for manual (card-to-card) payment.
model BankAccount {
  id            String   @id @default(cuid())
  bankName      String
  holderName    String
  cardNumber    String
  sheba         String?
  accountNumber String?
  note          String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Manual payment lifecycle per order (one-to-one). Approval is ALWAYS a human
// decision — no OCR, no hash matching, no auto-expiry, no auto-approval.
model Payment {
  id              String         @id @default(cuid())
  orderId         String         @unique
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          String         @default("awaiting_payment") // awaiting_payment | payment_review | paid | rejected | refund_pending | refunded
  amountSnapshot  Float
  receiptImage    String? // filename inside upload/receipts/ (never publicly served)
  payerName       String?
  trackingNumber  String?
  customerNote    String?
  reviewedByEmail String?
  reviewedAt      DateTime?
  rejectReason    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  events          PaymentEvent[]
}

// Audit trail for payment decisions (who approved/rejected, when, why).
model PaymentEvent {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type       String // receipt_submitted | resubmitted | approved | rejected | info
  actorEmail String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([paymentId])
}

// AI assistant conversation history (multi-turn memory, survives restarts).
model ConversationMessage {
  id             String   @id @default(cuid())
  telegramUserId String
  role           String // user | assistant
  content        String
  createdAt      DateTime @default(now())

  @@index([telegramUserId, createdAt])
}
