// Telegram Commerce Platform — Prisma schema (SQLite)
// Database is the single source of truth for products, inventory, customers, orders.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("seller") // admin | seller
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  description       String?
  shortDescription  String?
  // Final seller-approved price (Toman). NEVER auto-computed from silver rate,
  // weight or karat — see MASTER PROMPT §3 pricing law.
  price             Float             @default(0)
  compareAtPrice    Float?
  stock             Int               @default(0)
  lowStockThreshold Int               @default(5)
  categoryId        String?
  category          Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  imageUrl          String? // denormalized PRIMARY image (kept in sync with images[])
  status            String            @default("draft") // draft | active | inactive | out_of_stock
  aiGenerated       Boolean           @default(false)
  tags              String? // JSON array string
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // ─── Silver Love: optional per-type specs (never required, never priced) ───
  productCode       String? @unique // کد محصول
  silverType        String? // نوع نقره (استرلینگ، عیار ۹۲۵، …)
  fineness          Int? // عیار (875 / 925 / 950 / 999)
  weightGrams       Float? // وزن (گرم)
  size              String? // سایز (حلقه/دستبند) یا Free
  dimensions        String? // ابعاد
  brand             String? // برند یا سازنده
  appearance        String? // مشخصات ظاهری
  careInstructions  String? // شرایط نگهداری
  authenticityNote  String? // اصالت و ضمانت

  images      ProductImage[]
  telegramProducts TelegramProduct[]
  orderItems       OrderItem[]
  embedding        ProductEmbedding?
}

// ─── Product gallery (multiple images, one primary) ─────────────────────────

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String // relative /api/uploads/<name> or absolute URL
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

// ─── Customers & Orders ──────────────────────────────────────────────────────

model Customer {
  id              String    @id @default(cuid())
  telegramUserId  String    @unique
  telegramUsername String?
  firstName       String
  lastName        String?
  phone           String?
  address         String?
  // Operator handoff flag raised by the AI assistant (panel sees these)
  handoffRequested     Boolean  @default(false)
  handoffNote          String?
  handoffRequestedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  orders          Order[]
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  Int         @unique // allocated via Counter inside the order transaction
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status       String      @default("pending") // pending|confirmed|processing|shipped|completed|cancelled
  // Manual payment dimension (separate from fulfilment status):
  // awaiting_payment|payment_review|paid|rejected|refund_pending|refunded
  paymentStatus String     @default("awaiting_payment")
  subtotal     Float
  discount     Float       @default(0)
  total        Float
  customerName String // snapshot
  address      String
  phone        String
  trackingCode String? // کد رهگیری پستی (admin-managed)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
  payments     Payment[]

  @@index([status])
  @@index([paymentStatus])
  @@index([customerId])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot String // historical orders never change
  unitPriceSnapshot   Float
  quantity            Int
  total               Float

  @@index([orderId])
}

// ─── Manual card-to-card payments (no gateway — admin approves by hand) ──────

model Payment {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Float // snapshot of order total at submission time
  receiptUrl     String // PRIVATE path: /api/receipts/<name> (never public)
  payerName      String?
  trackingNumber String? // شماره پیگیری واریز (informational only — no dedup logic)
  customerNote   String?
  status         String    @default("awaiting_review") // awaiting_review|approved|rejected
  reviewNote     String? // admin note — REQUIRED when rejecting
  reviewedBy     String? // admin user id (audit)
  reviewedByName String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
}

// Bank card destinations the admin manages from the panel (multiple allowed)
model PaymentDestination {
  id            String   @id @default(cuid())
  bankName      String
  accountHolder String
  cardNumber    String
  sheba         String?
  accountNumber String?
  note          String?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Manual silver rate (admin-entered; reference info ONLY — never prices products) ───

model SilverRate {
  id           String   @id @default(cuid())
  ratePerGram  Float // تومان per gram of silver
  unit         String   @default("تومان / گرم")
  note         String? // توضیحات یا منبع نرخ
  active       Boolean  @default(true)
  createdBy    String? // admin user id
  createdByName String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ─── AI assistant conversation memory (survives restarts) ───────────────────

model ChatMessage {
  id             String   @id @default(cuid())
  telegramUserId String
  role           String // user | assistant
  content        String
  createdAt      DateTime @default(now())

  @@index([telegramUserId, createdAt])
}

// ─── Telegram integration ────────────────────────────────────────────────────

// Mapping product → channel post, enables editing existing posts (no duplicates)
model TelegramProduct {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  channelId       String
  messageId       Int
  lastContentHash String?
  publishedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, channelId])
}

// ─── RAG-ready knowledge base ────────────────────────────────────────────────

model ProductEmbedding {
  id         String   @id @default(cuid())
  productId  String   @unique
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  content    String // embedded text
  embedding  String // JSON float[] (vector storage; swap for pgvector/pgvector later)
  metadata   String? // JSON {name, category, price, status}
  model      String   @default("local-hash-v1")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Bot conversation state (survives restarts) ─────────────────────────────

model BotSession {
  telegramUserId String   @id
  state          String   @default("{}") // JSON state machine
  updatedAt      DateTime @updatedAt
}

// Atomic named counters (e.g. orderNumber sequence)
model Counter {
  name  String @id
  value Int    @default(0)
}

// ─── Settings & structured logs ──────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  level     String   @default("info") // info | warn | error
  type      String // order.created, telegram.publish, ai.generate, auth.failed, …
  message   String
  data      String? // JSON payload (never secrets)
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}
